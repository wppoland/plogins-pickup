#. Plugin Name of the plugin
#: prenejo.php
msgid "Prenejo - Local Pickup for WooCommerce"
msgstr "Prenejo - odbiór osobisty dla WooCommerce"

#. Plugin URI of the plugin
#: prenejo.php
