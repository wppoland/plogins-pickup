#: src/Service/CheckoutFields.php:110
msgid "Select a date to see available times."
msgstr "Wybierz datę, aby zobaczyć dostępne godziny."

#: src/Service/CheckoutFields.php:111
msgid "No times available on this date. Please choose another."
msgstr "Brak dostępnych godzin w tym dniu. Wybierz inny."

#: src/Service/CheckoutFields.php:112
msgid "This date is not available for pickup. Please choose another."
msgstr "Ta data nie jest dostępna do odbioru. Wybierz inną."

